# Cloudflare Pages 缓存头配置
# 参考: https://developers.cloudflare.com/pages/platform/headers

# HTML 文件不缓存，每次都检查更新
/*.html
  Cache-Control: no-cache, no-store, must-revalidate

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

# 根路径
/
  Cache-Control: no-cache, no-store, must-revalidate

# 版本文件不缓存
/version.json
  Cache-Control: no-cache, no-store, must-revalidate

# 静态资源长期缓存（带hash的文件）
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# 其他静态资源
/*.png
  Cache-Control: public, max-age=86400

/*.ico
  Cache-Control: public, max-age=86400

/*.svg
  Cache-Control: public, max-age=86400
